# ERA 32 R25：docker compose 本地开发环境变量模板。
# 复制为 .env 并生成真实随机值后再 `docker compose up`——
# 仓库内不再携带可用的默认秘密（config 对任何环境 fail-closed）。
#
# 生成示例（每项独立执行一次）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=change-me-generate-random
JWT_SECRET=change-me-generate-random
FIELD_ENCRYPTION_SECRET=change-me-generate-random
BOOTSTRAP_KEY=change-me-generate-random

# 可选：ENVIRONMENT=local|pilot|production（默认 local）
ENVIRONMENT=local
