classDiagram
    class DerivedFeature {
        +str tenant_id
        +str user_id
        +str event_id
        +str source
        +datetime window_start
        +str summary
        +list vector
        +list sources_present
    }
    class GapFinder {
        <<service>>
        +EXPECTED_SOURCES: tuple
        +find_gaps(db, tenant_id, user_id, run_date, audit_summary) list
        +_row_sources(row) set
        +_day_features(db, tenant_id, user_id, run_date) list
    }
    class AuditDay {
        <<service>>
        +audit_day(db, tenant_id, user_id, run_date) dict
        +sources_present: list
    }
    class ToolForge {
        <<service>>
        +forge_tools(db, tenant_id, user_id, gaps) list
    }
    class SkillInduct {
        <<service>>
        +_TOOL_TYPE_TO_ACTION_TYPE: dict
        +induct_skills(db, tenant_id, user_id, validated_tools) list
    }
    class TrendsService {
        <<service legacy>>
        +build_trend(db, tenant_id, user_id, days) dict
    }
    GapFinder --> DerivedFeature : reads sources_present union
    AuditDay --> DerivedFeature : reads
    ToolForge ..> GapFinder : consumes gaps (no mood_check)
    SkillInduct ..> ToolForge : consumes tools
    TrendsService ..> routes.case_review : internal data_quality only

    class SensingEventHub {
        +snapshotAll(): HubSnapshot
        +clearConsumed(snapshot: HubSnapshot)
        +clearAll()
    }
    class HubSnapshot {
        +List accel
        +List gyro
        +List screen
        +List notifications
        +List appActivities
        +List micDerived
    }
    class SensingWindowScheduler {
        +flushWindow(start, end, onWindowReady): WindowFlushResult
        +MAX_WINDOW_RETRY: int
        -pendingRetries: Map
    }
    class WindowFlushResult {
        <<enum>>
        SUCCESS
        FAILURE_RETRYABLE
    }
    class PassiveSensingService {
        +startSensing()
        +stopSensing()
        +canStartSensing(): bool
    }
    class LocalRepository {
        +saveDerivedFeatures(inputs): Boolean
        +saveSkillCompletion(input)
        +loadActiveSession(): ActiveSkillSession?
        +verifyOnboardingCode(code): OnboardingVerifyResult
    }
    class ActiveSkillSessionEntity {
        +sessionId PK
        +skillId
        +skillVersion
        +skillRevision
        +actionType
        +status
        +currentStep
        +startedAt
        +accumulatedActiveMs
        +segmentStartedAtMs
        +pausedAt
        +updatedAt
    }
    class SkillRunSession {
        +start() pause() resume() complete() stop()
        +activeDurationMs(now): Long
        +status: SkillRunStatus
    }
    class ActionRenderer {
        <<interface>>
        +Composable render(skill, session, repository)
    }
    class GuidedStepsRenderer
    class BreathingRenderer
    class ChecklistRenderer
    class JournalingRenderer
    class ReflectionPromptRenderer
    class BlockedRenderer {
        <<fail closed>>
    }
    ActionRenderer <|.. GuidedStepsRenderer
    ActionRenderer <|.. BreathingRenderer
    ActionRenderer <|.. ChecklistRenderer
    ActionRenderer <|.. JournalingRenderer
    ActionRenderer <|.. ReflectionPromptRenderer
    ActionRenderer <|.. BlockedRenderer

    SensingWindowScheduler --> SensingEventHub : snapshot/clearConsumed
    SensingWindowScheduler --> LocalRepository : onWindowReady Boolean
    PassiveSensingService --> SensingWindowScheduler : start/stop
    SkillRunSession --> ActiveSkillSessionEntity : persist/recover
    SkillRunSession ..> ActionRenderer : dispatches by action_type whitelist

    class AppPreferences {
        +lastSuccessfulCollection: Long
        +lastPersistenceFailure: Long?
        +consecutivePersistenceFailures: Int
        +onboardingState: String
    }
    class OnboardingVerifyRoute {
        <<route>>
        +POST /v1/onboarding/verify-code {code} -> OnboardingVerifyOut
    }
    class SkillOut {
        +action_type: str
        +estimated_duration: int?
        +completion_schema: dict?
        +safety_constraints: list?
        +revision: int
    }
    OnboardingVerifyRoute --> User : resolve external_ref
    OnboardingVerifyRoute ..> auth.create_access_token : mint opaque token
    SkillOut ..> SkillDisplay : android consumes contract fields
