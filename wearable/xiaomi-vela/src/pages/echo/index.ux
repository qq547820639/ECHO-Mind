<template>
  <div class="page" onclick="onTap">
    <div class="time-area">
      <text class="time-text">{{ timeText }}</text>
      <text class="headline-text" if="{{ headline }}">{{ headline }}</text>
      <text class="hint-text" else>{{ $t('message.echo_tap_hint') }}</text>
    </div>
    <div class="organism">
      <div class="orbit-ring" style="width:{{ orbitSize }}px;height:{{ orbitSize }}px;opacity:{{ orbitAlpha }};border-color:{{ accent }};transform:rotate({{ orbitRotate }}deg);"></div>
      <div class="glow" style="width:{{ glowSize }}px;height:{{ glowSize }}px;background-color:{{ accent }};opacity:{{ glowOpacity }};"></div>
      <div class="core" style="width:{{ coreSize }}px;height:{{ coreSize }}px;background-color:{{ accent }};opacity:{{ coreAlpha }};"></div>
      <div class="particle" for="{{ particles }}" style="left:{{ $item.x }}px;top:{{ $item.y }}px;width:{{ $item.radius }}px;height:{{ $item.radius }}px;background-color:{{ accent }};opacity:{{ $item.alpha }};"></div>
    </div>
    <div class="action-entry" onclick="onActionEntry">
      <text class="action-entry-text">{{ $t('message.action_title') }}</text>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 100%;
  height: 100%;
}
.time-area {
  flex-direction: column;
  align-items: center;
  margin-top: 60px;
}
.time-text {
  color: #f5f5f0;
  font-size: 44px;
  font-weight: 300;
}
.headline-text {
  color: #b8b8ae;
  font-size: 15px;
  margin-top: 14px;
  text-align: center;
  max-lines: 2;
}
.hint-text {
  color: #6a6a62;
  font-size: 13px;
  margin-top: 14px;
}
.organism {
  width: 212px;
  height: 212px;
  align-items: center;
  justify-content: center;
  margin-top: 40px;
}
.orbit-ring {
  position: absolute;
  border-radius: 50%;
  border-width: 1px;
  border-style: solid;
}
.glow {
  position: absolute;
  border-radius: 50%;
}
.core {
  position: absolute;
  border-radius: 50%;
}
.particle {
  position: absolute;
  border-radius: 50%;
}
.action-entry {
  position: absolute;
  bottom: 40px;
  border-width: 1px;
  border-color: #3c3c36;
  border-radius: 24px;
  padding-left: 24px;
  padding-right: 24px;
  padding-top: 10px;
  padding-bottom: 10px;
}
.action-entry-text {
  color: #8a8a80;
  font-size: 15px;
}
</style>

<script>
const visual = require('../../common/visual/wear_visual.js')
const cache = require('../../common/presence/presence_cache.js')

let tick = 0
let timer = null

export default {
  data: {
    timeText: '--:--',
    headline: null,
    coreSize: 44,
    orbitSize: 140,
    glowSize: 88,
    orbitAlpha: 0.4,
    glowOpacity: 0.16,
    coreAlpha: 0.85,
    accent: 'rgb(190, 180, 160)',
    orbitRotate: 0,
    particles: [],
  },

  onInit() {
    this.cache = this.$app.$def.cache || cache.create()
    this.cache.load()
    this.updateTime()
  },

  onShow() {
    this.refresh()
    this.startTimer()
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  refresh() {
    const state = this.cache.state(Date.now())
    const opts = { phase: state.phase }
    if (state.phase === 'empty') {
      this.headline = this.$t('message.why_fallback')
      this.accent = 'rgb(190, 180, 160)'
      this.coreSize = 44
      this.orbitSize = 140
      this.glowSize = 88
      this.particles = []
      this.intervalMs = 1500
      return
    }
    const v = visual.computeVisual(state.envelope, opts)
    this.headline = v.headline
    this.coreSize = v.coreRadius * 2
    this.orbitSize = v.orbitRadius * 2
    this.glowSize = v.glowRadius * 2
    this.orbitAlpha = v.orbitAlpha
    this.coreAlpha = v.coreAlpha
    this.accent = v.accent
    this.particles = v.particles.map((p) => ({
      x: 106 + p.dx - p.radius,
      y: 106 + p.dy - p.radius,
      radius: p.radius * 2,
      alpha: p.alpha,
    }))
    this.intervalMs = v.intervalMs
  },

  startTimer() {
    this.stopTimer()
    const self = this
    const interval = this.intervalMs || 1200
    timer = setInterval(() => {
      tick += 1
      const phase = tick % 120
      const breathe = Math.sin((phase / 120) * Math.PI * 2)
      self.orbitRotate = (phase / 120) * 360
      self.orbitAlpha = (self.orbitAlpha + breathe * 0.02).toFixed(2)
      self.glowOpacity = (0.12 + 0.08 * (1 + breathe)).toFixed(2)
      self.coreSize = self.coreSize
      // 每 30s 校准一次时间（battery first）
      if (tick % 25 === 0) self.updateTime()
    }, interval)
  },

  stopTimer() {
    if (timer) {
      clearInterval(timer)
      timer = null
    }
  },

  updateTime() {
    const d = new Date()
    const hh = ('0' + d.getHours()).slice(-2)
    const mm = ('0' + d.getMinutes()).slice(-2)
    this.timeText = hh + ':' + mm
  },

  onTap() {
    try {
      this.$router.push('/why')
    } catch (e) {
      // 忽略
    }
  },

  onActionEntry() {
    try {
      this.$router.push('/action')
    } catch (e) {
      // 忽略
    }
  },
}
</script>
