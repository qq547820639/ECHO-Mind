<template>
  <div class="page">
    <div class="title-row">
      <text class="title-text">{{ $t('message.action_title') }}</text>
    </div>
    <div class="body-area">
      <div class="breathing-field" if="{{ running === 'BREATHING' }}">
        <div class="breath-core {{ hueClass }} {{ coreSizeClass }}"></div>
        <text class="body-text">{{ $t('message.action_breathing_hint') }}</text>
        <div class="stop-button" onclick="onStop">
          <text class="stop-text">{{ $t('message.action_stop') }}</text>
        </div>
      </div>
      <div class="pause-field" elif="{{ running === 'PAUSE' }}">
        <text class="body-text">{{ $t('message.action_pause_hint') }}</text>
        <div class="stop-button" onclick="onStop">
          <text class="stop-text">{{ $t('message.action_stop') }}</text>
        </div>
      </div>
      <div class="menu-field" else>
        <div class="menu-button" onclick="onBreathing">
          <text class="menu-text">{{ $t('message.action_breathing') }}</text>
        </div>
        <div class="menu-button" onclick="onPause">
          <text class="menu-text">{{ $t('message.action_pause') }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
@import '../common/echo.css';
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 100%;
  height: 100%;
}
.title-row {
  margin-top: 56px;
}
.title-text {
  color: #6a6a62;
  font-size: 13px;
  letter-spacing: 4px;
}
.body-area {
  flex: 1;
  align-items: center;
  justify-content: center;
}
.breathing-field {
  flex-direction: column;
  align-items: center;
}
.breath-core {
  border-radius: 50%;
  margin-bottom: 28px;
}
.pause-field {
  flex-direction: column;
  align-items: center;
}
.body-text {
  color: #e8e8e0;
  font-size: 17px;
  text-align: center;
  line-height: 1.6;
  max-lines: 3;
}
.menu-field {
  flex-direction: column;
}
.menu-button {
  width: 180px;
  border-width: 1px;
  border-color: #3c3c36;
  border-radius: 28px;
  padding-top: 18px;
  padding-bottom: 18px;
  margin-bottom: 22px;
  align-items: center;
}
.menu-text {
  color: #e0e0d8;
  font-size: 18px;
}
.stop-button {
  margin-top: 30px;
  border-width: 1px;
  border-color: #3c3c36;
  border-radius: 24px;
  padding-left: 26px;
  padding-right: 26px;
  padding-top: 10px;
  padding-bottom: 10px;
}
.stop-text {
  color: #8a8a80;
  font-size: 15px;
}
</style>

<script>
const bridge = require('../common/transport/interconnect_bridge.js')
const cache = require('../common/presence/presence_cache.js')
const visual = require('../common/visual/wear_visual.js')
const throttle = require('../common/haptic/haptic_throttle.js')
// §7 触觉宪法：short/long 共用同一节流门（两次振动间隔 ≥1.5s；模块级单例）
const hapticGate = throttle.create(() => Date.now())

let breathTimer = null
let tick = 0

export default {
  private: {
    running: null,
    hueClass: 'hue-neutral',
    coreSizeClass: 'core-s',
    hapticsEnabled: false,
  },

  onShow() {
    const c = this.$app.$def.cache || cache.create()
    c.load()
    const state = c.state(Date.now())
    if (state.phase !== 'empty') {
      const v = visual.computeVisual(state.envelope, {})
      const identity = state.envelope.identity || {}
      this.hueClass = 'hue-' + visual.hueBucket(identity.accent)
      const diameter = v.coreRadius * 2
      this.coreSizeClass = diameter < 60 ? 'core-s' : (diameter < 78 ? 'core-m' : 'core-l')
      // 触觉开关来自手机推送的 PUBLIC_SAFE surface（默认 SILENT）。
      // false → 本页所有 vibrateShort/vibrateLong 必须 no-op（不能只有手机 UI 看起来关了）。
      this.hapticsEnabled = state.envelope.surface.hapticsEnabled === true
    } else {
      this.hapticsEnabled = false
    }
  },

  onHide() {
    this.stopBreathTimer()
  },

  onDestroy() {
    this.stopBreathTimer()
  },

  /** 用户主动呼吸：同一个 BREATHING Action（手机 EchoActionRuntime 拥有）。 */
  onBreathing() {
    this.running = 'BREATHING'
    bridge.sendAction('START_BREATHING')
    this.vibrateShort()
    this.startBreathTimer()
  },

  onPause() {
    this.running = 'PAUSE'
    bridge.sendAction('START_PAUSE')
    this.vibrateShort()
  },

  onStop() {
    this.stopBreathTimer()
    this.running = null
    bridge.sendAction('STOP_ACTION')
    this.vibrateLong() // action completion confirmation（显式触觉，允许）
  },

  startBreathTimer() {
    this.stopBreathTimer()
    const self = this
    // 呼吸节奏由 CSS keyframes（8s breatheScale）驱动——与手机 8s 循环同参；
    // JS 只负责 60s 自动结束（完成确认轻振）。
    breathTimer = setInterval(() => {
      tick += 1
      if (tick >= 60) {
        self.onStop()
      }
    }, 1000)
  },

  stopBreathTimer() {
    if (breathTimer) {
      clearInterval(breathTimer)
      breathTimer = null
    }
    tick = 0
  },

  /** 只使用官方确认存在的 Band10 振动能力：short / long。
   *  硬门：surface.hapticsEnabled !== true → 一律 no-op（Breathing / Stop / Action complete 全静默）。
   *  节流：两次振动间隔 ≥1.5s（haptic_throttle，契约 §7 速率限制）。 */
  vibrateShort() {
    if (this.hapticsEnabled !== true) return
    if (!hapticGate.allow()) return // 契约 §7：速率限制 ≥1.5s（快速连点/呼吸→结束的第二次 no-op）
    try {
      const vibrator = require('@system.vibrator')
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {
      // 无振动能力：静默（SILENT 默认）
    }
  },

  vibrateLong() {
    if (this.hapticsEnabled !== true) return
    if (!hapticGate.allow()) return // 契约 §7：完成确认同样受 ≥1.5s 节流
    try {
      const vibrator = require('@system.vibrator')
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {
      // 静默
    }
  },
}
</script>
