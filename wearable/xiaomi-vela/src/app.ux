<script>
export default {
  // Vela 应用级生命周期钩子是 onCreate（官方 demo 同款）；onInit 不会被调用
  // （官方模拟器实测：app 级 onInit 静默跳过 → 应用 UI 永不显示）。
  //
  // 重要约束（官方模拟器实测）：app 上下文**没有模块 require**——
  // 模块级 require 会让整个 app 脚本求值失败，所有 app 钩子 "call failed"，
  // 应用永不显示。官方 demo 的 app.ux 同样零 require。
  // 因此业务（interconnect/cache/传感器）全部由页面负责，app.ux 只保留生命周期。
  onCreate() {
  },
  onShow() {
  },
  onHide() {
  },
  onDestroy() {
  },
}
</script>
