<template>
  <div class="page">
    <div class="title-row">
      <text class="title-text">{{ $t('message.why_title') }}</text>
    </div>
    <div class="body-area" onclick="onTap">
      <text class="body-text" if="{{ headline }}">{{ headline }}</text>
      <text class="body-text" elif="{{ degraded }}">{{ $t('message.why_no_connection') }}</text>
      <text class="body-text" else>{{ $t('message.why_fallback') }}</text>
    </div>
    <div class="back-hint">
      <text class="back-hint-text">⌄</text>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 100%;
  height: 100%;
}
.title-row {
  margin-top: 56px;
}
.title-text {
  color: #6a6a62;
  font-size: 13px;
  letter-spacing: 4px;
}
.body-area {
  flex: 1;
  align-items: center;
  justify-content: center;
  padding-left: 28px;
  padding-right: 28px;
}
.body-text {
  color: #e8e8e0;
  font-size: 20px;
  text-align: center;
  line-height: 1.6;
  max-lines: 4;
}
.back-hint {
  margin-bottom: 36px;
}
.back-hint-text {
  color: #3c3c36;
  font-size: 18px;
}
</style>

<script>
import router from '@system.router'
const cache = require('../common/presence/presence_cache.js')

export default {
  private: {
    headline: null,
    degraded: false,
  },

  onShow() {
    const c = this.$app.$def.cache || cache.create()
    c.load()
    const state = c.state(Date.now())
    if (state.phase === 'fresh' || state.phase === 'degraded') {
      this.headline = state.envelope.publicHeadline || null
      this.degraded = state.phase === 'degraded'
    } else {
      this.headline = null
      this.degraded = false
    }
  },

  onTap() {
    try {
      router.back()
    } catch (e) {
      // 忽略
    }
  },
}
</script>
