#!/bin/sh
set -eu
VERSION=9.5.0
SHA256=553c78f50dafcd54d65b9a444649057857469edf836431389695608536d6b746
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/echo-bootstrap"
DIST="$BASE/gradle-$VERSION"
ZIP="$BASE/gradle-$VERSION-bin.zip"
if [ ! -x "$DIST/bin/gradle" ]; then
  mkdir -p "$BASE"
  if [ ! -f "$ZIP" ]; then
    command -v curl >/dev/null 2>&1 || { echo "需要 curl 下载 Gradle" >&2; exit 1; }
    # 官方源优先；本环境官方 307 落地主机不可达时回退镜像（完整性由下方 SHA256 钉定保证）
    curl -fL --connect-timeout 20 "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$ZIP" ||
      curl -fL --connect-timeout 20 "https://mirrors.cloud.tencent.com/gradle/gradle-$VERSION-bin.zip" -o "$ZIP"
  fi
  ACTUAL=$(sha256sum "$ZIP" | awk '{print $1}')
  [ "$ACTUAL" = "$SHA256" ] || { echo "Gradle 校验失败" >&2; rm -f "$ZIP"; exit 1; }
  command -v unzip >/dev/null 2>&1 || { echo "需要 unzip" >&2; exit 1; }
  rm -rf "$DIST"
  unzip -q "$ZIP" -d "$BASE"
fi
exec "$DIST/bin/gradle" "$@"
