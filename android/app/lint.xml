<?xml version="1.0" encoding="UTF-8"?>
<!-- Android lint 配置（ERA 31 硬门禁：warningsAsErrors = true；仅列豁免 + 理由）。 -->
<lint>
    <!-- UseKtx：ERA 39 复核——仍命中 50 处（43 处 SharedPreferences.edit + 5 处其他 + 2 处 Uri）。
         部分为刻意 commit() 同步写路径（KTX edit{} 默认 apply，语义不同），全量转换有行为风险无产品收益；保持豁免。 -->
    <issue id="UseKtx" severity="ignore" />

    <!-- 版本升级类提示：由 dependabot（github-actions/gradle/uv 生态）负责，不阻塞本地门禁。 -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Aligned16KB：SQLCipher 4.5.4 第三方 native 库未随 16KB 页对齐（上游依赖，非本仓库可修）；
         待上游发布对齐产物后移除豁免。 -->
    <issue id="Aligned16KB" severity="ignore" />

    <!-- ERA 39 探测固化（error 级，探测轮零命中）：PendingIntent 可变标志 / registerReceiver 标志 /
         WebView 启用 JS / 硬编码 RTL 方向。新增命中 = CI 红。 -->
    <issue id="UnspecifiedImmutableFlag" severity="error" />
    <issue id="UnspecifiedRegisterReceiverFlag" severity="error" />
    <issue id="SetJavaScriptEnabled" severity="error" />
    <issue id="RtlHardcoded" severity="error" />

    <!-- OldTargetApi：Visual Runtime V3 冻结 targetSdk=36（compileSdk 已升 37）；
         targetSdk 升级是独立兼容性决策，不在工具链切片内。 -->
    <issue id="OldTargetApi" severity="ignore" />

    <!-- NotShrinkingResources：release 打包行为在 v0.11.0 closure 已冻结（isMinifyEnabled 不配套
         shrinkResources）；是否开启资源压缩属发布闭环节奏决策，非工具链升级附带变更。 -->
    <issue id="NotShrinkingResources" severity="ignore" />
</lint>